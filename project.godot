; Editable Godot 4 project. Internal pixel resolution 640 x 360.
config_version=5

[application]
config/name="Brasafria"
config/version="0.14.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/icon.png"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=true
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.06, 1)

[audio]
driver/enable_input=false

[physics]
common/physics_ticks_per_second=60

[debug]
gdscript/warnings/inference_on_variant=0
